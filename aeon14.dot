strict digraph Aeon14 {
  labeljust = c
  composite = true
  node [shape=box,style=rounded]
  graph [style="dotted,rounded"]
  splines = line
  newrank = true
  // rankdir = LR

  subgraph cluster_age_sentience_wars {
    label = <<b>The Age of the Sentience Wars</b>>

    subgraph cluster_sentience_wars {
      label = "The Sentience Wars\l(ca. 2950-3010)"

      "Proteus Bridge" [style="dashed,rounded"]
      "Proteus Bridge" -> "Lyssa's Dream" [style=dotted]

      "Proteus Bridge"
      -> "Lyssa's Dream"
      -> "Lyssa's Run"
      -> "Lyssa's Flight"
      -> "Lyssa's Call"
      -> "Lyssa's Flame"
      -> "Lyssa's Light"
      -> "Lyssa's Return"
      -> "Lyssa's Descent"
      -> "Lyssa's Fury"
      -> "Lyssa's Vengeance"
    }

    peripheries = 0
  }


  subgraph cluster_age_colonization {
    label = <<b>The Second Age of Colonization</b>>

    "Lyssa's Vengeance" -> "Alpha Centauri" [style=invis]

    subgraph cluster_enfield_genesis {
      label = "Enfield Genesis\l(ca. 3190-3270)"

      "Alpha Centauri"
      -> "Proxima Centauri"
      -> "Tau Ceti"
      -> "Epsilon Eridani"
      -> "Sirius"
    }

    peripheries = 0
  }


  subgraph cluster_age_terra {
    label = <<b>The Age of Terra</b>>

    "Sirius" -> "Storming the\nNorse Wind" [style=invis]

    subgraph cluster_tanis {
      label = "Tanis Richards: Origins\l(ca. 4085)"

      "Storming the\nNorse Wind" [style="dashed,rounded"]

      "Storming the\nNorse Wind"
      -> "Shore Leave"
      -> "Masquerade"
      -> "Blackest Night"
      -> "Kill Shot"
    }

    subgraph cluster_intrepid {
      label = "The Intrepid Saga\l(ca. 4120-4170)"

      "Kill Shot" -> "Outsystem" [style=dashed]

      "Outsystem"
      -> "A Path in the Darkness"
      -> "Building Victoria"
    }

    bv_link_to_lcs [label="The Lost Colony Ship\nThe Woman Without a World",shape=rarrow,style=dashed]
    "Building Victoria" -> bv_link_to_lcs

    subgraph cluster_sol_dissolution {
      label = "The Sol Dissolution\l(ca. 4120-4180)"

      "Outsystem" -> "Venusian Uprising" [style=dashed,constraint=false]
      "Kill Shot" -> "Venusian Uprising" [style=invis,weight=0]

      "Venusian Uprising"
      -> "Assault on Sedna"
      -> "The Hyperion War"
      -> "The Fall of Terra"
    }

    peripheries = 0
  }

  subgraph cluster_age_ftl_wars {
    label = <<b>The Age of the FTL Wars</b>>
    rankdir = LR

    // { bv_link_to_lcs, "The Fall of Terra" }
    // -> { "The Daedalus Job", "Fire in the Night Sky" } [style=invis]
    bv_link_to_lcs -> "The Daedalus Job" [style=invis]

    subgraph cluster_outlaws_of_aquilia {
      label = "Outlaws of Aquilia\l(ca. 5960)"

      "The Daedalus Job"
      -> "Maelstrom Reach"
      -> "Marauder's Compass"
    }

    subgraph cluster_legacy_of_the_lost {
      label = "Legacy of the Lost\l(ca. 6780)"

      "Fire in the Night Sky"
      -> "A Blight Upon the Stars"
      -> "Spectre and an Invasion"
    }

    peripheries = 0
  }

  { "Spectre and an Invasion", "Marauder's Compass" }
  -> empire_link_from_bv [style=invis,weight=1]

  subgraph cluster_age_reconstruction {
    label = <<b>The Age of Reconstruction</b>>
    edge [weight=999]


    empire_link_from_bv [shape=larrow,style=dashed,label="Building Victoria"]
    empire_link_from_bv -> "The Woman Without a World"

    subgraph cluster_warlord {
      label = "The Warlord\l(ca. 8510)"

      // TODO: this should branch off from Building Victoria,
      // and branch back in at Orion Rising
      "The Woman Without a World"
      -> "The Woman who Seized an Empire"
      -> "The Woman who Lost Everything"
    }

    empire_link_to_ow [shape=rarrow,style=dashed,label="Attack on Thebes"]
    "The Woman who Lost Everything" -> empire_link_to_ow [style=dashed]

    peripheries = 0
  }

  subgraph cluster_age_orion_war {
    label = <<b>The Age of the Orion War</b>>
    edge [weight=999]

    lcs_link_from_bv [label="Building Victoria",shape=larrow,style=dashed]

    // For positioning only; Warlord actually merges back into
    // Orion War during Attack\non Thebes.
    empire_link_to_ow -> lcs_link_from_bv [style=invis]
    lcs_link_from_bv -> "The Lost\nColony Ship" [weight=999]

    ow_link_from_empire [label="The Woman who\nLost Everything",shape=larrow,style=dashed]
    ow_link_from_empire -> "Attack\non Thebes" [weight=0,style=dashed]
    // Positioning
    "Orion Rising" -> ow_link_from_empire [weight=0,style=invis]

    subgraph cluster_orion_war {
      label = "The Orion War\l(ca. 8930-8950)"

      "The Lost\nColony Ship"
      // spinoff: Set the Galaxy on Fire"
      -> "New Canaan"
      -> "Orion Rising"
      // spinoff: Ignite the Stars
      -> "The Scipio\nAlliance"
      -> "Attack\non Thebes"
      -> "War on a\nThousand Fronts"
      -> "Precipice\nof Darkness"
      -> "Airthan\nAscendancy"
      -> "Orion Front"
      -> "Starfire"
      -> "Return to\nKapteyn's Star" // interstitial
      -> "Race Across\nSpacetime"
      -> "Return to Sol:\nAttack at Dawn"
      -> "Return to Sol:\nStar Rise"
    }

    // TODO: how do I swap Building New Canaan with Perseus Gate?
    "New Canaan" -> "Carthage" [style=dashed,weight=0]
    subgraph cluster_new_canaan {
      label = "Building New Canaan\l(ca. 8935)"

      "Carthage" -> "Tyre" -> "Troy" -> "Athens"
    }
    "Athens" -> "New Canaan" [style=dashed,weight=0]

    "New Canaan" -> "The Gate at the\nGrey Wolf Star" [style=dashed,weight=0,constraint=true]

    subgraph cluster_perseus_gate {
      label = "The Perseus Gate\l(ca. 8938-8948)"

      "The Gate at the\nGrey Wolf Star"
      -> "The World at the\nEdge of Space"
      -> "The Dance on the\nMoons of Serenity"
      -> "The Last Bastion\nof Star City"
      -> "The Toll Road\nBetween the Stars"
      -> "The Final Stroll\non Perseus's Arm"
    }

    "The Final Stroll\non Perseus's Arm" -> "Orion Rising" [style=dashed,weight=0,constraint=true]
    "Orion Rising" -> "A Meeting of\nMinds and Bodies" [style=dashed,weight=0]

    subgraph cluster_perseus_gate_2 {
      label = "The Perseus Gate (Season 2)\l(ca. 8938-8948)"

      "A Meeting of\nMinds and Bodies"
      -> "A Deception and\na Promise Kept"
      -> "A Surreptitious\nRescue"
      -> "A Victory and a\nCrushing Defeat"
      -> "A Trial and the\nTribulations"
    }

    "A Deception and\na Promise Kept" -> "Precipice\nof Darkness" [style=dashed,weight=0]

    // Not sure where these fit in.
    // Serenity\l(ca. 8938)
    // Return to Ordus
    // War of the Rosette

    // }
    "The Lost\nColony Ship" -> "Close Proximity" [style=dashed,weight=0]
    "Decisive Action" -> "Attack\non Thebes" [style=dashed,weight=0]
    "Attack\non Thebes" -> "Impact Imminent" [style=dashed,weight=0]

    subgraph cluster_perilous_alliance {
      label = "Perilous Alliance\l(ca. 8937-8948)"

      // positioning
      // "The Scipio Alliance" -> "Decisive Action" [style=invis,weight=0]
      "Collision Course" -> "Decisive Action" [constraint=false]

      "Escape Velocity" [style="dashed,rounded"]
      "Decisive Action" [style="dashed,rounded"]
      "Mr. Fizzle Pop\nRuins Everything" [style="dashed,rounded"]

      "Escape Velocity"
      -> "Close Proximity"
      -> "Strike Vector"
      -> "Collision Course"
      -> "Decisive Action"
      -> "Impact Imminent"
      -> "Critical Inertia"
      -> "Impulse Shock"
      -> "Mr. Fizzle Pop\nRuins Everything"
      -> "Terminal Velocity"
    }

    "The Scipio\nAlliance" -> "The Empress\nand the Ambassador" [style=dashed,weight=0]
    subgraph cluster_empire {
      label = "The Empire\l(ca. 8948-8949)"

      "The Empress\nand the Ambassador"
      -> "Consort of the\nScorpion Empress"
      -> "By the Empress's\nCommand"
    }

    "Attack\non Thebes" -> "Whole Latte Death" [style=dashed,weight=0]

    subgraph cluster_fennington {
      label = "Fennington Station\nMurder Mysteries";

      "Whole Latte Death"
      -> "Cocoa Crush"
    }


    "Attack\non Thebes" -> "Rika Commander" [style=dashed,weight=0]

    subgraph cluster_rika_mech {
      label = "Rika's Marauders\l(ca. 8931-8949)"

      "Rika Mechanized" [style="dashed,rounded"]

      "Rika Mechanized"
      -> "Rika Outcast"
      -> "Rika Redeemed"
      -> "Rika Triumphant"
      -> "Rika Commander"
      -> "Rika Infiltrator"
      -> "Rika Unleashed"
      -> "Rika Conqueror"
    }

    "Rika Commander" -> "War on a\nThousand Fronts" [style=dashed,weight=0]
    "Rika Conqueror" -> "Rika Rising"

    subgraph cluster_rika_queen {
      label = "The Genevian Queen\l(ca. ????)"

      "Rika Rising"
      -> "Rika Coronated"
      -> "Rika Destroyer"
    }
  }

    // Spinoff set in New Eden
    // 428 15/08/8948 - The Delta Team 1 - The Eden Job
    // 452 07/03/8949 - The Delta Team 2 - The Disknee World
    // 459 03/04/8949 - The Delta Team 3 - Rogue Planets

}

