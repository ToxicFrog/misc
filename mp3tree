#!/usr/bin/env zsh

set -e
setopt nomonitor nonotify

MUSIC_DIR="${1:-/ancilla/media/music/Library}"
MP3_DIR="${2:-/ancilla/media/music/.srv}"

function probe-music {
  ffprobe &>/dev/null "$@"
}

function ffmpeg_convert() {
  input="$1"
  output="$2"
  shift 2
  # We need two calls to map_metadata here. The first one tells it to set
  # global metadata in the output from the metadata in the first stream of the
  # input. The second one tells it to also copy global metadata input->output.
  # This is necessary because some input formats, like opus, attach the metadata
  # to the audio stream, and some, like FLAC, attach it to the container, and
  # we need to handle both cases.
  </dev/null ffmpeg -y -i "$input" \
    -v error -nostats \
    -map_metadata 0:s:a:0 -map_metadata 0:g -map 0:0 \
    "$@" \
    -q:a 0 -codec:a libmp3lame \
    "$output" \
  || printf '\x1B[1;91m[FAIL] %s\x1B[0m\n' $input
}

NTHREADS=8
# Spawn a background job iff the number of background jobs is <= NTHREADS.
function spawn() {
  while [[ $#jobstates -ge $NTHREADS ]]; do
    sleep 1
    jobs &>/dev/null # reap finished children
  done
  "$@" &
}

# Keep a list of converted files here so we can find ones that are stale later.
printf '' > /tmp/$$.new

echo "Creating mp3s..."
mkdir -p $MP3_DIR
find "$MUSIC_DIR/" -path "$MP3_DIR" -prune -o -print | while read -r src; do
  # Strip non-FAT characters from filenames so we can e.g. rsync this onto USB
  # keys without everything being terrible.
  relpath="${src#$MUSIC_DIR/}"
  dst="${MP3_DIR}/$(echo "$relpath" | tr '<>:\"|?*' '[-*]' | sed -E 's;/+;/;g')"
  #echo "$src"
  #echo "  == $relpath"
  #echo "  -> $dst"

  # Handle directories. Create mirrors of non-empty directories, skip empty ones.
  if [[ -d $src ]]; then
    if [[ $(ls -A "$src") && ! -e "$dst" ]]; then
      echo "[DIR ] $dst"
      mkdir -p "$dst"
    else
      printf '\x1B[2K[SCAN] %s\r' $src
    fi
    continue
  fi

  # Handle files.
  # Cover files don't have their extensions changed, everything else becomes
  # an MP3.
  ext="${dst##*.}"
  dst_mp3="${dst%.*}.mp3"

  # Skip existing links.
  if [[ -e $dst && ! $src -nt $dst ]]; then
    echo "$dst" >> /tmp/$$.new
    continue
  fi
  # Skip existing converted files that are no older than the source.
  if [[ -e $dst_mp3 && ! $src -nt $dst_mp3 ]]; then
    echo "$dst_mp3" >> /tmp/$$.new
    continue
  fi

  # Now we process files that exist in the source but not the destination.
  case "$(echo "$src" | tr '[:upper:]' '[:lower:]')" in
    # All formats supported by both mstream and gonic (taglib).
    # Turns out some of these aren't supported by the phone?
    # *.mp3|*.mp4|*.flac|*.m4a|*.ogg|*.opus|*.aac)
    # *.mp3|*.flac|*.ogg|*.opus|*.aac)
    *.mp3)
      # TODO: can we convert *everything*, and burn in the replaygain information
      # as we do so?
      ln -sf "$src" "$dst"
      echo "$dst" >> /tmp/$$.new
      printf "\x1B[92m[LINK]\x1B[0m %s\n" $src
      ;;
    # Non-audio metadata like covers
    */cover.*|*.jpg|*.jpeg|*.png|*.bmp|*.gif|*.m3u)
      ln -sf "$src" "$dst"
      echo "$dst" >> /tmp/$$.new
      printf "\x1B[96m[META]\x1B[0m %s\n" $src
      ;;
    # Recognized formats we don't have converters for
    *.ahx)
      ;&
    # Things we always want to skip
    *.torrent|*.download*|*.backup|*.txt)
      ;;
    # Recognized formats that we need to convert
    *.dbm|*.gdm|*.hvl|*.imf|*.it|*.mo3|*.mod|*.mptm|*.mtm|*.s3m|*.umx|*.vgm|*.vgz|*.xm)
      ;&
    *.mpc|*.aif|*.aiff|*.wma|*.wav|*.mid|*.midi|*.opus|*.m4a|*.ogg|*.flac)
      spawn ffmpeg_convert "$src" "$dst_mp3"
      echo "$dst_mp3" >> /tmp/$$.new
      printf "\x1B[93m[CONV]\x1B[0m %s\n" $src
      ;;
    # Unrecognized format. See if ffprobe understands it.
    *)
      printf "\x1B[91m[????]\x1B[0m %s\n" $src
      # There are a LOT of module formats, so we delegate to openmpt's probe function
      # rather than trying to list all the extensions.
      if probe-music "$src"; then
        spawn ffmpeg_convert "$src" "$dst_mp3"
        echo "$dst_mp3" >> /tmp/$$.new
        printf "\x1B[93m[CONV]\x1B[0m %s\n" $src
      else
        # File is not recognized.
        continue
      fi
      ;;
  esac
done

while [[ $#jobstates -ge 1 ]]; do
  sleep 1
  jobs &>/dev/null # reap finished children
done

# Clean up all broken symlinks.
echo "Cleaning up broken symlinks..."
find "$MP3_DIR" -depth \( -type l -xtype l \) -print -delete

# Clean up all non-symlink files that no longer correspond to files in MUSIC_DIR.
echo "Cleaning up stale converted files..."
find "$MP3_DIR" -type f -or -type l > /tmp/$$.all
cat /tmp/$$.new /tmp/$$.all | sort | uniq -u \
  | xargs -r -d\\n rm -fv

# Clean up directories that have been emptied as a result of the above.
echo "Cleaning up empty directories..."
find "$MP3_DIR" -depth \( -type d -empty \) -print -delete

rm /tmp/$$.new /tmp/$$.all
touch $MP3_DIR/.NOBACKUP
echo "Done!"
